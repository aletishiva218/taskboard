# Database
POSTGRES_USER=taskboard
POSTGRES_PASSWORD=taskboard_secret
POSTGRES_DB=taskboard

# Redis
REDIS_PASSWORD=redis_secret

# App
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_another_long_random_string
SESSION_SECRET=change_this_to_yet_another_long_random_string

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email (Mailtrap for dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
EMAIL_FROM=TaskBoard <no-reply@taskboard.com>

# Security
UNSUBSCRIBE_SECRET=change_this_to_long_random_string
ADMIN_SECRET=change_this_to_admin_secret

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
